# Copy to .env and fill in. Never commit .env.

# Claude — needed for live categorization and the Claude-powered "Ask the data" box.
# Without it the app shows saved demo results and answers questions by keyword matching.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EXTRACT_EFFORT=low       # per-post triage; low is usually enough
# LLM_VIZ_EFFORT=medium
# EXTRACT_BATCH_SIZE=10

# What to monitor
TOPIC=flood
# Search terms for X and Bluesky
SEARCH_QUERIES=น้ำท่วม,น้ำป่า,ขอความช่วยเหลือ น้ำท่วม,Thailand flood
SOURCES=x,mastodon,bluesky
MAX_POST_AGE_DAYS=7
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TAGS=thailandflood,น้ำท่วม,ThailandFloods

# X (Twitter) API — create an app at https://console.x.com and copy its Bearer Token.
# Pay-per-use: each post returned costs credit (~$0.005/post), so there is a daily cap.
X_BEARER_TOKEN=
# X_QUERY=(น้ำท่วม OR น้ำป่า OR #น้ำท่วม) -is:retweet   # override the generated query
X_MAX_POSTS_PER_RUN=100
X_DAILY_POST_BUDGET=1000      # ≈ $5/day at $0.005/post
X_FIRST_RUN_HOURS=24          # how far back the very first fetch looks (max 7 days)

# Bluesky search needs a login. Use an app password (Settings → App passwords).
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Fetch + categorize automatically every POLL_MINUTES
LIVE_INGEST=false
POLL_MINUTES=10

# Phone numbers in post text are masked in the UI unless this is true.
SHOW_PII=false
# If set, POST /api/ingest requires "Authorization: Bearer <token>"
INGEST_TOKEN=

# Load 30 made-up demo posts when the database is empty (for demos only)
DEMO_DATA=false

PORT=3000
