{
  "name": "flood-situation-map",
  "version": "0.1.0",
  "private": true,
  "description": "Collects public social and news posts about disasters, uses Claude to categorize them, and shows them on a live map with prompt-driven charts.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/cli.js seed",
    "ingest": "node src/cli.js ingest",
    "extract": "node src/cli.js extract",
    "count": "node src/cli.js count",
    "backfill": "node src/cli.js backfill",
    "reset": "node src/cli.js reset",
    "tunnel": "cloudflared tunnel --no-autoupdate run --token-file data/tunnel.token",
    "classify-posters": "node -e \"import('./src/settings.js').then(()=>import('./src/posterType.js')).then(async m=>console.log(await m.classifyPosterTypes()))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "express": "^5.3.0",
    "zod": "^4.0.0"
  }
}
